# ============================================
# SKILLFORGE - Environment Variables
# ============================================

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/skillforge
# Or use MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/skillforge

# Authentication
# CRITICAL: Generate a secure 64-byte random secret for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Stream Chat (for real-time messaging and video)
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret
# Get these from: https://getstream.io/

# OpenAI (for AI tutoring features)
OPENAI_API_KEY=your-openai-api-key
# Get from: https://platform.openai.com/api-keys

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Get from: https://dashboard.stripe.com/

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_BASIC_MONTHLY_PRICE_ID=price_basic_monthly
STRIPE_BASIC_YEARLY_PRICE_ID=price_basic_yearly
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly

# Stripe Organization/B2B Price IDs
STRIPE_ORG_STARTER_PRICE_ID=price_org_starter
STRIPE_ORG_GROWTH_PRICE_ID=price_org_growth
STRIPE_ORG_ENTERPRISE_PRICE_ID=price_org_enterprise

# Cloudinary (for image/file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Get from: https://cloudinary.com/

# Email Service (optional - for notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@skillforge.com
SENDGRID_FROM_NAME=SkillForge
# Get from: https://sendgrid.com/

# Redis (optional - for better rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Analytics (optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# Sentry Error Tracking (optional)
SENTRY_DSN=your-sentry-dsn

# Admin Configuration
ADMIN_EMAILS=admin@skillforge.com,owner@skillforge.com

# Security
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
COOKIE_DOMAIN=localhost
SESSION_SECRET=your-session-secret-change-this

# Feature Flags
ENABLE_SUBSCRIPTIONS=true
ENABLE_ORGANIZATIONS=true
ENABLE_REFERRALS=true
ENABLE_GAMIFICATION=true
ENABLE_AI_FEATURES=true

# Production Deployment: Use strong secrets, production Stripe keys,
# managed MongoDB Atlas, Redis, HTTPS, proper CORS, and enable error tracking